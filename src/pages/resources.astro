---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recursos | VOCAB</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
  <div class="app">
    <header class="header">
      <div class="logo-area">
        <a href="/" class="logo">
          <span>VOCAB</span>
          <small>ENGLISH METHODOLOGY</small>
        </a>
      </div>
      <nav class="top-nav">
        <a href="/" class="nav-link">Práctica</a>
        <a href="/methodology" class="nav-link">Metodología</a>
        <a href="/pronunciation" class="nav-link">Pronunciación</a>
        <a href="/resources" class="nav-link active">Recursos</a>
        <a href="/ai-coach" class="nav-link">IA Coach</a>
      </nav>
    </header>

    <main class="main resources-page">
      <section class="method-hero">
        <h1>Recursos Recomendados</h1>
        <p class="hero-subtitle">Curado desde <a href="https://github.com/byoungd/English-level-up-tips" target="_blank">English Level Up Tips</a>. Materiales organizados por habilidad.</p>
      </section>

      <!-- Listening Resources -->
      <section class="resource-section">
        <h2>Listening (Escucha)</h2>
        <div class="resource-subsection">
          <h3>Para principiantes</h3>
          <div class="resource-grid">
            <a href="https://www.youtube.com/watch?v=Rp3LqMYBhkQ&list=PL2621D8F6B6B29B7B" target="_blank" class="resource-card">
              <span class="resource-type">YouTube</span>
              <strong>Basic English Grammar</strong>
              <p>Gramática básica explicada con vocabulario simple, velocidad adecuada</p>
            </a>
            <a href="https://www.youtube.com/channel/UCgzuT-fpJiyThTUlMiFRCKQ" target="_blank" class="resource-card">
              <span class="resource-type">YouTube</span>
              <strong>ValenESL</strong>
              <p>Lecciones muy básicas, vocabulario y gramática para empezar</p>
            </a>
          </div>
        </div>

        <div class="resource-subsection">
          <h3>Series de TV para listening</h3>
          <div class="resource-grid">
            <div class="resource-card">
              <span class="resource-type">TV</span>
              <strong>Friends (B1-B2)</strong>
              <p>Clásica. Vocabulario cotidiano, humor, velocidad moderada</p>
            </div>
            <div class="resource-card">
              <span class="resource-type">TV</span>
              <strong>Modern Family (B1-B2)</strong>
              <p>Ganadora de Emmy. Diálogos naturales, excelentes guiones</p>
            </div>
            <div class="resource-card">
              <span class="resource-type">TV</span>
              <strong>Better Call Saul (B2-C1)</strong>
              <p>Diálogos complejos. Solo para nivel intermedio-alto</p>
            </div>
          </div>
        </div>

        <div class="resource-subsection">
          <h3>Podcasts y Audio</h3>
          <div class="resource-grid">
            <a href="https://www.audible.com/" target="_blank" class="resource-card">
              <span class="resource-type">App</span>
              <strong>Audible</strong>
              <p>Audiobooks narrados por profesionales. Excelente para listening extensivo</p>
            </a>
            <div class="resource-card">
              <span class="resource-type">Podcast</span>
              <strong>6 Minute English (BBC)</strong>
              <p>Temas cortos en inglés británico. Ideal para B1</p>
            </div>
            <div class="resource-card">
              <span class="resource-type">Podcast</span>
              <strong>All Ears English</strong>
              <p>Inglés americano conversacional. B1-B2</p>
            </div>
          </div>
        </div>

        <div class="resource-subsection">
          <h3>Música para entrenar oído</h3>
          <div class="resource-grid">
            <div class="resource-card">
              <span class="resource-type">Tip</span>
              <strong>Cómo usar música</strong>
              <p>1. Busca la letra. 2. Aprende vocabulario. 3. Escucha identificando las palabras. 4. Canta.</p>
            </div>
            <a href="https://www.youtube.com/c/xooos" target="_blank" class="resource-card">
              <span class="resource-type">YouTube</span>
              <strong>xooos</strong>
              <p>Covers acústicos con pronunciación clara</p>
            </a>
          </div>
        </div>
      </section>

      <!-- Reading Resources -->
      <section class="resource-section">
        <h2>Reading (Lectura)</h2>
        
        <div class="resource-subsection">
          <h3>Libros por nivel</h3>
          <div class="resource-grid">
            <div class="resource-card">
              <span class="resource-level">A2-B1</span>
              <strong>Animal Farm — George Orwell</strong>
              <p>Fábula política. Corta, poderosa, vocabulario accesible</p>
            </div>
            <div class="resource-card">
              <span class="resource-level">B1</span>
              <strong>The Curious Incident of the Dog in the Night-time</strong>
              <p>Narrador único. Lógica clara, lenguaje simple pero efectivo</p>
            </div>
            <div class="resource-card">
              <span class="resource-level">B1-B2</span>
              <strong>The Diary of a Young Girl — Anne Frank</strong>
              <p>Escritura expresiva, contexto histórico impactante</p>
            </div>
            <div class="resource-card">
              <span class="resource-level">B1-B2</span>
              <strong>Harry Potter series — J.K. Rowling</strong>
              <p>Dificultad progresiva. Excelente para reading extensivo</p>
            </div>
            <div class="resource-card">
              <span class="resource-level">B2</span>
              <strong>The Kite Runner — Khaled Hosseini</strong>
              <p>Ficción contemporánea emotiva. Bien escrita</p>
            </div>
            <div class="resource-card">
              <span class="resource-level">B2-C1</span>
              <strong>On Writing Well — William Zinsser</strong>
              <p>Manual de escritura. Para leer con cuidado y aprender estilo</p>
            </div>
            <div class="resource-card">
              <span class="resource-level">B2-C1</span>
              <strong>Merriam-Webster's Vocabulary Builder</strong>
              <p>Vocabulario en contexto con ejercicios. La referencia principal de vocabulario</p>
            </div>
          </div>
        </div>

        <div class="resource-subsection">
          <h3>Lectura online</h3>
          <div class="resource-grid">
            <a href="https://www.medium.com" target="_blank" class="resource-card">
              <span class="resource-type">Web</span>
              <strong>Medium</strong>
              <p>Artículos de alta calidad sobre cualquier tema. Tech, vida, diseño</p>
            </a>
            <a href="https://www.quora.com" target="_blank" class="resource-card">
              <span class="resource-type">Web</span>
              <strong>Quora</strong>
              <p>Preguntas y respuestas. Historias y opiniones contextuales</p>
            </a>
            <a href="https://www.reddit.com" target="_blank" class="resource-card">
              <span class="resource-type">Web</span>
              <strong>Reddit</strong>
              <p>Comunidades temáticas, inglés casual y discusiones</p>
            </a>
            <a href="https://news.ycombinator.com" target="_blank" class="resource-card">
              <span class="resource-type">Web</span>
              <strong>Hacker News</strong>
              <p>Noticias tech. Discusiones de alto nivel técnico</p>
            </a>
          </div>
        </div>
      </section>

      <!-- Speaking Resources -->
      <section class="resource-section">
        <h2>Speaking (Habla)</h2>
        <div class="resource-grid">
          <a href="https://www.youtube.com/user/EnglishAnyone" target="_blank" class="resource-card">
            <span class="resource-type">YouTube</span>
            <strong>EnglishAnyone</strong>
            <p>Entrenamiento de fluidez. Pronunciación clara</p>
          </a>
          <a href="https://www.youtube.com/user/theteachervanessa" target="_blank" class="resource-card">
            <span class="resource-type">YouTube</span>
            <strong>Speak English With Vanessa</strong>
            <p>Práctica conversacional. Entusiasta y clara</p>
          </a>
          <a href="https://www.youtube.com/c/AJHogeEffortlessEnglish" target="_blank" class="resource-card">
            <span class="resource-type">YouTube</span>
            <strong>A.J. Hoge - Effortless English</strong>
            <p>Método de fluidez sin gramática explícita</p>
          </a>
          <a href="https://www.youtube.com/channel/UCMTcsanYhBtOb096XegDZQA" target="_blank" class="resource-card">
            <span class="resource-type">YouTube</span>
            <strong>AccurateEnglish</strong>
            <p>Pronunciación detallada y fonética</p>
          </a>
        </div>

        <div class="resource-subsection">
          <h3>Temas para practicar solo</h3>
          <div class="practice-topics">
            <span class="topic-chip">Preséntate</span>
            <span class="topic-chip">Describe tu ciudad</span>
            <span class="topic-chip">¿Cómo fue tu día?</span>
            <span class="topic-chip">3 cosas que te hacen feliz</span>
            <span class="topic-chip">Cuenta un recuerdo</span>
            <span class="topic-chip">Opina sobre un producto</span>
            <span class="topic-chip">Explica tu trabajo</span>
            <span class="topic-chip">Describe tu rutina</span>
          </div>
        </div>
      </section>

      <!-- Grammar & Vocab Resources -->
      <section class="resource-section">
        <h2>Gramática y Vocabulario</h2>
        <div class="resource-grid">
          <a href="https://www.youtube.com/user/EnglishLessons4U" target="_blank" class="resource-card">
            <span class="resource-type">YouTube</span>
            <strong>Ronnie - engVid</strong>
            <p>Gramática con humor. Divertida y efectiva</p>
          </a>
          <a href="https://www.youtube.com/channel/UCz4tgANd4yy8Oe0iXCdSWfA" target="_blank" class="resource-card">
            <span class="resource-type">YouTube</span>
            <strong>English with Lucy</strong>
            <p>Inglés británico. Vocabulario y gramática clara</p>
          </a>
          <a href="https://apps.ankiweb.net/" target="_blank" class="resource-card">
            <span class="resource-type">App</span>
            <strong>Anki</strong>
            <p>Flashcards con repetición espaciada científica. Gratis en PC/Android</p>
          </a>
        </div>
      </section>

      <!-- Tech English -->
      <section class="resource-section">
        <h2>English for Tech</h2>
        <div class="resource-grid">
          <a href="https://www.youtube.com/channel/UC29ju8bIPH5as8OGnQzwJyA" target="_blank" class="resource-card">
            <span class="resource-type">YouTube</span>
            <strong>Traversy Media</strong>
            <p>Frontend. Pronunciación estándar, ritmo lento. Ideal para desarrolladores</p>
          </a>
          <a href="https://www.youtube.com/channel/UCW5YeuERMmlnqo4oq8vwUpg" target="_blank" class="resource-card">
            <span class="resource-type">YouTube</span>
            <strong>The Net Ninja</strong>
            <p>CSS, JS, frameworks. Tutoriales paso a paso</p>
          </a>
          <a href="https://laracasts.com/" target="_blank" class="resource-card">
            <span class="resource-type">Web</span>
            <strong>Laracasts</strong>
            <p>PHP, Laravel, Vue, JS. Explicaciones detalladas</p>
          </a>
          <a href="https://egghead.io/" target="_blank" class="resource-card">
            <span class="resource-type">Web</span>
            <strong>egghead.io</strong>
            <p>Cursos frontend concisos y de alta calidad</p>
          </a>
        </div>
      </section>

      <!-- AI Tools -->
      <section class="resource-section">
        <h2>Herramientas IA para aprender</h2>
        <p class="section-desc">Cada herramienta tiene su rol. No busques una única herramienta, usa cada una donde es más fuerte.</p>
        <div class="resource-grid">
          <div class="resource-card ai-card">
            <strong>Gemini — Plataforma de aprendizaje</strong>
            <p>Gems + Live + Canvas + Quiz/Flashcards. La cadena más completa para estudiar.</p>
            <small>Ideal: curso largo, oral, materiales &rarr; quiz</small>
          </div>
          <div class="resource-card ai-card">
            <strong>ChatGPT — Enseñanza paso a paso</strong>
            <p>Study Mode + Projects. Explica, pregunta, verifica comprensión.</p>
            <small>Ideal: gramática, lectura detallada, errores</small>
          </div>
          <div class="resource-card ai-card">
            <strong>Claude — Escritura y textos largos</strong>
            <p>Projects con RAG. Procesa tus materiales y da feedback profundo.</p>
            <small>Ideal: escritura, estilo, feedback extenso</small>
          </div>
          <div class="resource-card ai-card">
            <strong>Perplexity — Encontrar materiales</strong>
            <p>Spaces con búsqueda. Encuentra artículos y recursos de calidad.</p>
            <small>Ideal: buscar contenido, research</small>
          </div>
          <div class="resource-card ai-card">
            <strong>DeepL Write — Pulido final</strong>
            <p>Asistente de escritura. Revisa naturalidad, tono y concisión.</p>
            <small>Ideal: última revisión de emails y textos</small>
          </div>
        </div>
      </section>

      <!-- TED Talks -->
      <section class="resource-section">
        <h2>Videos recomendados</h2>
        <div class="resource-grid">
          <a href="https://www.youtube.com/watch?v=d0yGdNEWdn0" target="_blank" class="resource-card">
            <span class="resource-type">TEDx</span>
            <strong>Cómo aprender un idioma en 6 meses</strong>
            <p>Chris Lonsdale explica los principios de adquisición rápida</p>
          </a>
          <a href="https://www.youtube.com/watch?v=5MgBikgcWnY" target="_blank" class="resource-card">
            <span class="resource-type">TEDx</span>
            <strong>The first 20 hours</strong>
            <p>Josh Kaufman: cómo aprender cualquier habilidad rápidamente</p>
          </a>
          <a href="https://www.youtube.com/watch?v=w-HYZv6HzAs" target="_blank" class="resource-card">
            <span class="resource-type">TEDx</span>
            <strong>The Skill of Self-Confidence</strong>
            <p>Dr. Ivan Joseph: la confianza como habilidad entrenable</p>
          </a>
          <a href="https://www.youtube.com/watch?v=eIho2S0ZahI" target="_blank" class="resource-card">
            <span class="resource-type">TED</span>
            <strong>How to speak so that people want to listen</strong>
            <p>Julian Treasure: técnicas de comunicación efectiva</p>
          </a>
        </div>
      </section>

      <footer class="method-footer">
        <p>Todos los recursos curados desde <a href="https://github.com/byoungd/English-level-up-tips" target="_blank" rel="noopener">English Level Up Tips by byoungd</a></p>
      </footer>
    </main>
  </div>
</body>
</html>
