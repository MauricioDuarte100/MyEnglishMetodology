---
import SiteLayout from '../layouts/SiteLayout.astro';
import TrackCards from '../components/TrackCards.astro';
import { learningTracks } from '../data/navigation.js';
---
<SiteLayout title="Entrenamiento">
  <div class="training-heading"><div><span class="eyebrow">TU PANEL · INGLÉS INTENSIVO</span><h1>Entrenamiento de hoy</h1><p>Produce, corrige y repite. Sube la velocidad cuando la precisión te acompañe.</p></div><a href="/progreso" class="text-link">Ver mi progreso →</a></div>
  <div class="training-metrics" aria-label="Tu rendimiento"><div><span>NIVEL DE ARENA</span><strong id="dashboardXP">0 XP</strong><small id="dashboardLevel">Cadete</small></div><div><span>PRECISIÓN</span><strong id="dashboardAccuracy">—</strong><small id="dashboardAnswers">0 respuestas verificadas</small></div><div><span>MEJOR COMBO</span><strong id="dashboardCombo">x0</strong><small>Respuestas correctas seguidas</small></div><div><span>REPASOS VENCIDOS</span><a href="/practica/fundamentos/tarjetas?category=review" aria-label="Abrir los repasos vencidos"><strong id="dashboardDue">0</strong></a><a href="/practica/fundamentos/tarjetas?category=loop" id="dashboardErrors">0 palabras para reforzar</a></div></div>
  <div class="training-grid">
    <section class="coach-panel" aria-labelledby="coachTitle"><div class="coach-panel-top"><span class="eyebrow">SPRINT GUIADO</span><label>Recorrido<select id="trainingTrackSelect" aria-label="Recorrido del sprint">{learningTracks.map(track => <option value={track.id}>{track.title}</option>)}</select></label></div><span class="coach-phase" id="coachPhase">Fase 1 de 3 · Fundamentos</span><h2 id="coachTitle">Comienza: Tarjetas</h2><p id="coachDescription">Repasa diez tarjetas, verifica lo aprendido y entrena el oído.</p><ol class="coach-steps" id="coachSteps"><li class="current"><span class="coach-step-number">01</span><div><strong>Tarjetas</strong><small>10 tarjetas</small></div></li><li><span class="coach-step-number">02</span><div><strong>Quiz</strong><small>8 respuestas</small></div></li><li><span class="coach-step-number">03</span><div><strong>Dictado</strong><small>3 respuestas</small></div></li></ol><div class="coach-actions"><a class="primary-link" id="startGuidedSprint" href="/practica/fundamentos/tarjetas?guided=1">Comenzar sprint guiado →</a><a class="text-link" href="/practica">Práctica libre</a></div></section>
    <aside class="training-side"><section class="daily-target"><div class="section-heading"><span class="eyebrow">OBJETIVO DIARIO</span><strong id="dailyCorrect">0 / 20</strong></div><h2>20 aciertos. Sin atajos.</h2><progress id="dailyGoalMeter" max="20" value="0" aria-label="Aciertos de la meta diaria"></progress><p id="dailyGoalMessage">Practica expresiones diferentes. La repetición consolida; la producción verifica.</p></section><section class="arena-challenge"><span class="eyebrow">DESAFÍO DE VELOCIDAD</span><h2>Supera a ShadowDev.</h2><p>Misiones técnicas, combos y bonus por responder rápido. Tu rival es simulado.</p><progress id="arenaLevelMeter" max="100" value="0" aria-label="Progreso del nivel de Arena"></progress><small id="arenaNextLevel">500 XP para el siguiente objetivo</small><a class="arena-link" href="/practica/profesional/arena">Entrar a la Arena <span aria-hidden="true">↗</span></a></section></aside>
  </div>
  <section class="section-block" aria-labelledby="paths-heading"><div class="section-heading"><h2 id="paths-heading">Tus recorridos de entrenamiento</h2><a class="text-link" href="/biblioteca/metodologia">El método →</a></div><TrackCards /></section>
  <script src="../scripts/training-dashboard.js"></script>
</SiteLayout>
