---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { learningTracks, exerciseHref } from '../../../data/navigation.js';
export const prerender = true;
export function getStaticPaths() { return learningTracks.map(track => ({ params: { track: track.slug }, props: { track } })); }
const { track } = Astro.props;
---
<SiteLayout title={track.title}>
  <nav class="breadcrumbs" aria-label="Ubicación"><a href="/practica">Práctica</a><span aria-hidden="true">/</span><span aria-current="page">{track.title}</span></nav>
  <div class="page-intro"><span class="eyebrow">{track.tag}</span><h1>{track.title}</h1><p>{track.description}</p></div>
  <div class="route-recommendation"><div><span class="eyebrow">PRIMER PASO SUGERIDO</span><h2>{track.exercises[0].title}</h2><p>{track.exercises[0].description}</p></div><a class="primary-link" href={exerciseHref(track, track.exercises[0])}>Comenzar práctica →</a></div>
  <section class="section-block" aria-labelledby="exercises-heading"><div class="section-heading"><h2 id="exercises-heading">Ejercicios de este recorrido</h2><span>Elige el que necesites</span></div>
    <div class="exercise-grid">{track.exercises.map((exercise, i) => <a class="exercise-card" href={exerciseHref(track, exercise)}><span class="exercise-number">0{i + 1}</span><div><h3>{exercise.title}</h3><p>{exercise.description}</p></div><span aria-hidden="true">→</span></a>)}</div>
  </section>
</SiteLayout>
